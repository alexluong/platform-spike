model
  schema 1.1

# a merchant user; delegate = the agents of the grants this user created
type user
  relations
    define delegate: [agent_grant#agent]

# platform staff (platform_admin, support)
type staff

type app

type agent

type platform
  relations
    define admin: [staff]
    define support: [staff]
    define platform_merchant_create: admin
    define platform_merchant_view: admin or support
    define platform_merchant_suspend: admin
    define platform_app_register: admin
    define platform_audit_view: admin
    define platform_break_glass: admin or support

# a system or custom role: which grantable permissions it holds
type role
  relations
    define merchant_view: [user:*, agent:*]
    define merchant_update: [user:*, agent:*]
    define member_manage: [user:*, agent:*]
    define role_manage: [user:*, agent:*]
    define store_create: [user:*, agent:*]
    define store_view: [user:*, agent:*]
    define product_create: [user:*, agent:*]
    define product_update: [user:*, agent:*]
    define product_view: [user:*, agent:*]
    define order_view: [user:*, agent:*]
    define order_cancel: [user:*, agent:*]
    define order_refund: [user:*, user:* with refund_limit, agent:*, agent:* with refund_limit]
    define payment_capture: [user:*, agent:*]
    define payment_view: [user:*, agent:*]
    define shipment_create: [user:*, agent:*]
    define shipment_update: [user:*, agent:*]
    define shipment_view: [user:*, agent:*]
    define app_install: [user:*, agent:*]
    define app_uninstall: [user:*, agent:*]
    define app_view: [user:*, agent:*]
    define agent_grant: [user:*, agent:*]
    define role_manage_owner: [user:*]

# one role assignment: subject holds role (at the scope that points to this binding)
type role_binding
  relations
    define subject: [user, user#delegate]
    define role: [role]
    define merchant_view: subject and merchant_view from role
    define merchant_update: subject and merchant_update from role
    define member_manage: subject and member_manage from role
    define role_manage: subject and role_manage from role
    define store_create: subject and store_create from role
    define store_view: subject and store_view from role
    define product_create: subject and product_create from role
    define product_update: subject and product_update from role
    define product_view: subject and product_view from role
    define order_view: subject and order_view from role
    define order_cancel: subject and order_cancel from role
    define order_refund: subject and order_refund from role
    define payment_capture: subject and payment_capture from role
    define payment_view: subject and payment_view from role
    define shipment_create: subject and shipment_create from role
    define shipment_update: subject and shipment_update from role
    define shipment_view: subject and shipment_view from role
    define app_install: subject and app_install from role
    define app_uninstall: subject and app_uninstall from role
    define app_view: subject and app_view from role
    define agent_grant: subject and agent_grant from role
    define role_manage_owner: subject and role_manage_owner from role

